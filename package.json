{
  "name": "basic-crud",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p .",
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "start:prod": "npm run build && node dist/index.js",
    "start:multi:dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/cluster.ts",
    "start:multi": "npm run build && node dist/cluster.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
